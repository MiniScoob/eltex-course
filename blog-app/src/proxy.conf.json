{
  "/api/**": {
    "target": "http://localhost:3000",
    "pathRewrite": { "^/api" : "" },
    "secure": false
  },
  "/uploads/*": {
    "target": "http://localhost:3000",
    "secure": false
  },
  "/websocket": {
