{
  "name": "blog-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href=/eltex-course/ && cp dist/blog-app/browser/index.html dist/blog-app/browser/404.html",
    "deploy": "npx angular-cli-ghpages --dir=dist/blog-app/browser",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:blog-app": "node dist/blog-app/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.10",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "apollo-angular": "^14.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@apollo/client": "^4.0.1",
    "graphql": "^16"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "angular-cli-ghpages": "^3.0.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
